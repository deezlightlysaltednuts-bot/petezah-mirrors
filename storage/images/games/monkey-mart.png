ool Mode"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg></button><button class="ciog-surprise-btn" type="button" aria-label="Open Surprise Game"><span class="ciog-gift-icon" aria-hidden="true">🎁</span><span aria-hidden="true">Surprise</span></button><div class="ciog-surprise-popup" aria-hidden="true"><div class="ciog-popup-box"><button class="ciog-popup-close" type="button" aria-label="Close Popup">×</button><div class="ciog-popup-badge" aria-hidden="true">TOP GAME</div><div class="ciog-popup-game-thumb"></div><div class="ciog-popup-title" id="ciogGameTitle" role="presentation" aria-hidden="true"></div><a href="#" class="ciog-popup-play" rel="nofollow">▶ Play Now</a></div></div><style>
.ciog-surprise-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: var(--hdr-control);
  padding: 0 12px;
  border-radius: var(--osoft-radius);
  background: var(--osoft-bg);
  border: 1px solid var(--osoft-border);
  color: var(--header-text);
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1;
  cursor: pointer;
  transition: .15s ease;
  box-shadow: var(--osoft-inset);
  white-space: nowrap;
  font-family: inherit;
}
.ciog-surprise-btn:hover {
  background: var(--osoft-hover);
  color: var(--osoft-icon-hover);
  border-color: color-mix(in srgb, var(--site-accent) 35%, var(--osoft-border));
  box-shadow: var(--osoft-inset), 0 0 14px color-mix(in srgb, var(--site-accent) 12%, transparent);
}
.ciog-gift-icon {
  font-size: 14px;
  line-height: 1;
}

.ciog-surprise-popup {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(0, 0, 0, 0.82);
  backdrop-filter: blur(8px);
  z-index: 999999;
}
.ciog-surprise-popup.active {
  display: flex;
}
.ciog-popup-box {
  position: relative;
  width: 100%;
  max-width: 420px;
  padding: 22px 18px 24px;
  border-radius: 24px;
  background: var(--site-bg-elevated);
  border: 1px solid var(--theme-border);
  text-align: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), 0 0 35px color-mix(in srgb, var(--site-accent) 10%, transparent);
}
.ciog-popup-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  color: #fff;
  font-size: 22px;
  cursor: pointer;
  transition: .15s;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ciog-popup-close:hover {
  background: rgba(255, 255, 255, 0.10);
  transform: rotate(90deg);
}
.ciog-popup-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 18px;
  border-radius: 999px;
  background: var(--site-accent);
  color: #fff;
  font-size: 13px;
  font-weight: 900;
  margin-bottom: 18px;
}
.ciog-popup-game-thumb {
  width: 180px;
  height: 180px;
  margin: 0 auto 18px;
  border-radius: 22px;
  overflow: hidden;
  border: 2px solid var(--theme-border);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}
.ciog-popup-game-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ciog-popup-title {
  font-size: 26px;
  line-height: 1.15;
  font-weight: 900;
  color: #fff;
  margin-bottom: 18px;
}
.ciog-popup-play {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 28px;
  border-radius: 999px;
  background: var(--site-accent);
  color: #fff;
  font-size: 18px;
  font-weight: 900;
  text-decoration: none;
  transition: .15s ease;
}
.ciog-popup-play:hover {
  background: var(--site-accent-hover);
  transform: translateY(-2px);
  box-shadow: 0 0 20px color-mix(in srgb, var(--site-accent) 20%, transparent);
  color: #fff;
}

@media (max-width: 768px) {
  .ciog-surprise-btn {
    height: 36px;
    padding: 0 10px;
    font-size: 0.72rem;
  }
  .ciog-popup-box {
    padding: 20px 14px 22px;
  }
  .ciog-popup-game-thumb {
    width: 160px;
    height: 160px;
  }
  .ciog-popup-title {
    font-size: 22px;
  }
  .ciog-popup-play {
    font-size: 16px;
    padding: 12px 24px;
  }
}
